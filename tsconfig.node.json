{
  "compilerOptions": {
    "skipLibCheck": true,
    "outDir": "./dist/node/",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDirs": ["src/common", "src/node"],
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/common", "src/node"]
}
