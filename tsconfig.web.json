{
  "compilerOptions": {
    "skipLibCheck": true,
    "outDir": "./dist/web/",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDirs": ["src/common", "src/web"],
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/common", "src/web"],
  "exclude": ["src/common/lib/crypto/node-driver.ts"]
}
